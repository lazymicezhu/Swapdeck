<Window x:Class="Swapdeck.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="切号" WindowStyle="None" Width="385" Height="650" Typography.NumeralAlignment="Tabular" ResizeMode="CanMinimize" MinWidth="385" MaxWidth="385" MinHeight="650" MaxHeight="650" WindowStartupLocation="CenterScreen" Icon="Swapdeck.ico" FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="SwitchStyle" TargetType="ToggleButton"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Track" Background="#777A7F" CornerRadius="10" Padding="2"><Ellipse x:Name="Thumb" Width="14" Fill="White" HorizontalAlignment="Left"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#2879FF"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="Padding" Value="10,5"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="14" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CaptionButton" TargetType="Button">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/>
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#227F7F7F"/></Trigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Close"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></MultiTrigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Background="{DynamicResource WindowBg}">
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
   <StackPanel WindowChrome.IsHitTestVisibleInChrome="True" x:Name="Tabs" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="0" WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE72C;" Width="26" Height="24" FontSize="13" Foreground="{DynamicResource Muted}" ToolTip="刷新" x:Name="RefreshButton" Click="RefreshClick" Padding="5,3"/>
    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE713;" Width="26" Height="24" FontSize="13" Foreground="{DynamicResource Muted}" ToolTip="设置" Click="SettingsClick" Padding="5,3"/>
   </StackPanel>
   <StackPanel Grid.Column="2" WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal" VerticalAlignment="Top">
    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="最小化" AutomationProperties.Name="最小化" Click="MinClick"/>
    <Button Style="{StaticResource CaptionButton}" Tag="Close" Content="&#xE8BB;" ToolTip="关闭" AutomationProperties.Name="关闭" Click="CloseClick"/>
   </StackPanel>
  </Grid>
  <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16,6,16,22" x:Name="Cards"/></ScrollViewer>
  <Grid Grid.Row="2" x:Name="Footer" Margin="16,4,16,16"><Rectangle x:Name="SlotOutline" Stroke="{DynamicResource Muted}" StrokeDashArray="5,4" RadiusX="16" RadiusY="16" StrokeThickness="1.2" Opacity=".45"/><Button x:Name="AddButton" Content="＋  添加中转" FontSize="12.5" Foreground="{DynamicResource Muted}" Padding="8,14" Click="AddClick"/><Border x:Name="Choices" Background="{DynamicResource Ink}" Padding="18,14,18,6" CornerRadius="18" Visibility="Collapsed"><StackPanel x:Name="ChoiceRows"/></Border></Grid>
  <Border x:Name="ToastBox" Grid.RowSpan="3" Background="{DynamicResource Back}" CornerRadius="10" Margin="22,0,22,80" BorderThickness="1" BorderBrush="#18777777" Padding="0" ClipToBounds="True" VerticalAlignment="Bottom" Visibility="Collapsed"><Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity=".12"/></Border.Effect><Grid><Rectangle x:Name="ToastBlur" RadiusX="10" RadiusY="10" Opacity=".28" IsHitTestVisible="False"><Rectangle.Effect><BlurEffect Radius="8"/></Rectangle.Effect></Rectangle><TextBlock Margin="14,8" FontSize="12" x:Name="ToastText" TextWrapping="Wrap" Foreground="{DynamicResource Text}" TextAlignment="Center"/></Grid></Border>
  <Border x:Name="Scrim" Grid.RowSpan="3" Background="#55000000" Visibility="Collapsed"/>
 </Grid>
</Window>
